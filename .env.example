# ==============================================================================
# MICROSERVICES INFRASTRUCTURE — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and update the passwords with secure values:
#
#   cp .env.example .env
#
# To generate a secure password:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))"
#
# NEVER commit the .env file to version control.
# ==============================================================================


# ==============================================================================
# GLOBAL CONFIGURATION
# ==============================================================================

COMPOSE_PROJECT_NAME=microservices-infra
DOMAIN_NAME=darkstar.local


# ==============================================================================
# 01-DATA: PostgreSQL (Centralized)
# ==============================================================================

POSTGRES_VERSION=15-alpine
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=main_db

# -- Keycloak Database (created by init script) --
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db_password

# -- Kong Database (created by init script) --
KONG_DB_NAME=kong
KONG_DB_USER=kong
KONG_DB_PASSWORD=CHANGE_ME_kong_db_password

# -- Application Database (for your microservices) --
APP_DB_NAME=app_db
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_app_db_password


# ==============================================================================
# 01-DATA: MongoDB
# ==============================================================================

MONGO_VERSION=6.0
MONGO_USER=mongoadmin
MONGO_PASSWORD=CHANGE_ME_mongo_password


# ==============================================================================
# 01-DATA: Redis
# ==============================================================================

REDIS_VERSION=7.2-alpine
REDIS_USER=redis_user
REDIS_PASSWORD=CHANGE_ME_redis_password


# ==============================================================================
# 01-DATA: Elasticsearch
# ==============================================================================

ELASTICSEARCH_VERSION=8.11.1
ELASTIC_CLUSTER_NAME=docker-cluster
ELASTIC_DISCOVERY_TYPE=single-node
ELASTIC_XPACK_SECURITY=false
ELASTIC_JAVA_OPTS=-Xms512m -Xmx512m


# ==============================================================================
# 01-DATA: MinIO (S3-Compatible Object Storage)
# ==============================================================================

MINIO_VERSION=RELEASE.2024-01-01T00-00-00Z
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGE_ME_minio_password

# -- MinIO Service Accounts --
OBSERVABILITY_USER=observability-service
OBSERVABILITY_SERVICE_PASSWORD=CHANGE_ME_observability_password
APP_SERVICE_PASSWORD=CHANGE_ME_app_service_password
BACKUP_SERVICE_PASSWORD=CHANGE_ME_backup_service_password


# ==============================================================================
# 02-MESSAGING: Apache Kafka (KRaft Mode)
# ==============================================================================

KAFKA_VERSION=7.5.0
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CLUSTER_ID=m4ZxI6qIQvWOea8emAKqJw


# ==============================================================================
# 02-MESSAGING: Kafka UI
# ==============================================================================

KAFKA_UI_PORT=8081


# ==============================================================================
# 03-OBSERVABILITY: Prometheus
# ==============================================================================

PROMETHEUS_VERSION=v2.48.0
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB


# ==============================================================================
# 03-OBSERVABILITY: Grafana
# ==============================================================================

GRAFANA_VERSION=10.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
GRAFANA_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource


# ==============================================================================
# 03-OBSERVABILITY: Loki (Logs)
# ==============================================================================

LOKI_VERSION=2.9.0
LOKI_PORT=3100


# ==============================================================================
# 03-OBSERVABILITY: Tempo (Traces)
# ==============================================================================

TEMPO_VERSION=2.3.0
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4319
TEMPO_OTLP_HTTP_PORT=4320


# ==============================================================================
# 03-OBSERVABILITY: Mimir (Metrics Long-Term Storage)
# ==============================================================================

MIMIR_VERSION=2.11.0
MIMIR_PORT=9009
MIMIR_GRPC_PORT=9095


# ==============================================================================
# 03-OBSERVABILITY: Pyroscope (Continuous Profiling)
# ==============================================================================

PYROSCOPE_VERSION=1.4.0
PYROSCOPE_PORT=4040


# ==============================================================================
# 03-OBSERVABILITY: OpenTelemetry Collector
# ==============================================================================

OTEL_COLLECTOR_VERSION=0.91.0
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8888
OTEL_COLLECTOR_HEALTH_PORT=13133


# ==============================================================================
# 03-OBSERVABILITY: Kibana
# ==============================================================================

KIBANA_VERSION=8.11.0
KIBANA_SECURITY_ENABLED=false
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_char_hex_string_here
KIBANA_REPORTING_KEY=CHANGE_ME_32_char_hex_string_here
KIBANA_SECURITY_KEY=CHANGE_ME_32_char_hex_string_here


# ==============================================================================
# 03-OBSERVABILITY: Other Components
# ==============================================================================

CADVISOR_VERSION=v0.47.2
CADVISOR_PORT=8088

NODE_EXPORTER_VERSION=v1.7.0
NODE_EXPORTER_PORT=9100

GRAFANA_AGENT_VERSION=latest
GRAFANA_AGENT_PORT=12345

GRAFANA_ALLOY_VERSION=latest
ALLOY_PORT=12345


# ==============================================================================
# 04-GATEWAY: Kong API Gateway
# ==============================================================================

KONG_VERSION=3.4
KONG_PG_HOST=postgres
KONG_PG_PORT=5432
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8445
KONG_ADMIN_PORT=8001
KONG_ADMIN_SSL_PORT=8444
KONG_PROXY_ACCESS_LOG=/dev/stdout
KONG_ADMIN_ACCESS_LOG=/dev/stdout
KONG_PROXY_ERROR_LOG=/dev/stderr
KONG_ADMIN_ERROR_LOG=/dev/stderr


# ==============================================================================
# 04-GATEWAY: Keycloak (Identity & Access Management)
# ==============================================================================

KEYCLOAK_VERSION=23.0
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
KEYCLOAK_DB_HOST=postgres
KEYCLOAK_DB_PORT=5432
KEYCLOAK_HOSTNAME=localhost/auth
KEYCLOAK_HOSTNAME_STRICT=false
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_MGMT_PORT=9004
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true


# ==============================================================================
# 04-GATEWAY: Nginx Reverse Proxy
# ==============================================================================

NGINX_VERSION=1.25-alpine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443


# ==============================================================================
# 05-OPS: Jenkins (CI/CD)
# ==============================================================================

JENKINS_VERSION=lts-jdk17
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=CHANGE_ME_jenkins_password
JENKINS_HTTP_PORT=8082
JENKINS_AGENT_PORT=50000


# ==============================================================================
# 05-OPS: Portainer (Container Management)
# ==============================================================================

PORTAINER_VERSION=2.19.4-alpine
PORTAINER_HTTP_PORT=9002
PORTAINER_HTTPS_PORT=9443


# ==============================================================================
# 05-OPS: Security Scanning
# ==============================================================================

TRIVY_VERSION=0.48.0
SEMGREP_APP_TOKEN=


# ==============================================================================
# 05-OPS: Mailpit (Email Testing)
# ==============================================================================

MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
