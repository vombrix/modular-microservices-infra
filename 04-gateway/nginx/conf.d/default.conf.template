# ==============================================================================
# NGINX CONFIGURATION TEMPLATE
# ==============================================================================
# Reverse proxy configuration for the data, observability, and ops stacks.
# Variables like ${DOMAIN_NAME} are substituted at runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# DEFAULT CATCH-ALL & HEALTHCHECK
# ------------------------------------------------------------------------------
server {
    listen 80 default_server;
    server_name _;

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Proxy Keycloak auth endpoints if accessed via localhost
    location ~* ^/(realms|resources|admin|js)/ {
        set $upstream_keycloak http://keycloak:8080;
        proxy_pass $upstream_keycloak;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}

